USENET_IMAGE=ghcr.io/guohai163/usenet-view:latest
WEB_BIND=127.0.0.1
WEB_PORT=3000

# 内置 PostgreSQL 的随机十六进制密码。部署指南中有生成命令。
POSTGRES_PASSWORD=
# 使用内置 PostgreSQL 时留空。外部 PostgreSQL 或直接运行 Node.js 时填写。
DATABASE_URL=

NNTP_HOST=news.cnusenet.org
NNTP_GROUPS=cn.announce
NNTP_INITIAL_LIMIT=0
NNTP_SYNC_INTERVAL_SEC=300
NNTP_TIMEOUT_MS=30000
NNTP_MAX_ARTICLE_BYTES=67108864
